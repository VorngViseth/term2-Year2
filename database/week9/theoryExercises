select * from Orders where Year(OrderDate) = 1996;
select o.OrderID, concat(e.FirstName, ' ', e.LastName) as EmployeeName from Orders o join Employees e on o.EmployeeID = e.EmployeeID where o.ShippedDate > o.RequiredDate;
select c.city, count(e.EmployeeID), count(c.CustomerID) from Employees e join Orders o on e.EmployeeID = o.EmployeeID join Customers c on c.CustomerID = o.CustomerID
group by City;
select count(CustomerID) from Orders where OrderDate > "1996-12-31";
